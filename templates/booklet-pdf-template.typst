// ==============================================================================
// Typst Template for Booklet Printing: "What Not To Do When There Is A Murder In Town"
// Conditions:
// 1. All title pages (book title, acknowledgments, about the author, chapter beginnings)
//    start on ODD page numbers (1, 3, 5, etc.). Blank pages inserted automatically before them.
// 2. Back cover and front cover (in that order) placed at the end of the PDF.
// ==============================================================================

#show pagebreak: it => {
  if it.to == "odd" or it.to == "even" {
    [#metadata(none)<empty-page-start>] + it + [#metadata(none)<empty-page-end>]
  } else {
    it
  }
}

#let is-page-empty() = {
  let page-num = here().position().page
  let markers = query(selector(<empty-page-start>).or(selector(<empty-page-end>)))
  let empty = false
  for i in range(0, markers.len(), step: 2) {
    if i + 1 < markers.len() {
      let start-p = markers.at(i).location().position().page
      let end-p = markers.at(i + 1).location().position().page
      if start-p < page-num and page-num < end-p {
        empty = true
      }
    }
  }
  empty
}

#let conf(
  title: "",
  author: "",
  date: none,
  doc,
) = {
  // Document metadata
  set document(title: "$title$", author: "$author$")

  // ---------------------------------------------------------------------------
  // 1. BOOK TITLE PAGE (Page 1: Odd page)
  // ---------------------------------------------------------------------------
  set page(
    paper: "a4",
    margin: (top: 40mm, bottom: 25mm, left: 28mm, right: 28mm),
    header: none,
    footer: none,
  )
  
  align(center)[
    #v(3.5cm)
    #text(size: 32pt, weight: "bold")[#title]
    #v(1.5cm)
    #text(size: 20pt, weight: "bold")[#author]
    #v(1fr)
    #text(size: 12pt, fill: luma(80))[Copyright © 2026 #author. All rights reserved.]
  ]

  pagebreak(to: "odd")

  // ---------------------------------------------------------------------------
  // 2. INTERIOR PAGES (Acknowledgments, Chapters 1-17, About the Author)
  // ---------------------------------------------------------------------------
  set page(
    paper: "a4",
    margin: (top: 25mm, bottom: 25mm, left: 28mm, right: 28mm),
    header: context {
      let current-page = counter(page).get().first()
      let is-chapter-page = query(heading.where(level: 1)).any(h => h.location().position().page == current-page)
      if not is-chapter-page and not is-page-empty() {
        align(center)[
          #text(size: 10pt, fill: luma(110), tracking: 0.1em)[
            #smallcaps[What Not To Do When There Is A Murder In Town]
          ]
        ]
      }
    },
    footer: context {
      if not is-page-empty() {
        align(center)[
          #text(size: 11pt, fill: luma(60))[#counter(page).display("1")]
        ]
      }
    },
  )

  // Typography settings
  set text(size: 15.5pt, lang: "en")
  set par(
    justify: false,
    leading: 0.85em,
    spacing: 1.3em,
    first-line-indent: 0pt,
  )

  // Chapter Headings & Section Headings (Always start on ODD page numbers)
  show heading.where(level: 1): it => {
    pagebreak(weak: true, to: "odd")
    v(1.4cm)
    align(center)[
      #text(size: 24pt, weight: "bold")[#it.body]
      #v(0.6em)
      #text(font: "Arial Unicode MS", size: 12pt, fill: luma(110), tracking: 0.5em)[✧ ✧ ✧]
    ]
    v(1.0cm)
  }

  // Dividers (---)
  show line: set align(center)

  // Blockquotes / Poems
  show quote: it => block(
    inset: (left: 2.5em),
    spacing: 1.4em,
    it.body
  )

  doc

  // ---------------------------------------------------------------------------
  // 3. COVERS AT THE END (Back Cover then Front Cover)
  // ---------------------------------------------------------------------------
  pagebreak(to: "odd")
  set page(
    paper: "a4",
    margin: 0pt,
    header: none,
    footer: none,
  )
  image("src/assets/back-cover.png", width: 100%, height: 100%, fit: "cover")

  pagebreak()
  set page(
    paper: "a4",
    margin: 0pt,
    header: none,
    footer: none,
  )
  image("src/assets/front-cover.png", width: 100%, height: 100%, fit: "cover")
}

#let horizontalRule = align(center)[#line(length: 40%, stroke: 0.5pt + luma(130))]
#let divider = if "divider" in std { divider } else { horizontalRule }

#show: doc => conf(
  title: [$title$],
  author: [$author$],
  doc,
)

$body$
